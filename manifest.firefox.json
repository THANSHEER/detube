{
  "manifest_version": 3,
  "name": "DeTube",
  "version": "3.2.0",
  "description": "Distraction-free YouTube experience.",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content/detube.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "detube@geekstash.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
