{
  "name": "detube",
  "version": "3.5.0",
  "description": "Distraction-free YouTube experience.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build:css": "node scripts/build-css.js",
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run build:css && npm run generate-icons && npm run build:chrome && npm run build:firefox && npm run build:edge && npm run build:safari && npm run build:opera && npm run zip:builds",
    "build:chrome": "tsc && TARGET_BROWSER=chrome vite build",
    "build:firefox": "tsc && TARGET_BROWSER=firefox vite build",
    "build:edge": "tsc && TARGET_BROWSER=edge vite build",
    "build:safari": "tsc && TARGET_BROWSER=safari vite build",
    "build:opera": "tsc && TARGET_BROWSER=opera vite build",
    "zip:builds": "node scripts/zip-builds.js",
    "watch": "npm run watch:chrome",
    "watch:chrome": "npm run build:css && npm run build:chrome -- --watch",
    "watch:firefox": "npm run build:css && npm run build:firefox -- --watch",
    "watch:safari": "npm run build:css && npm run build:safari -- --watch",
    "watch:opera": "npm run build:css && npm run build:opera -- --watch",
    "test": "npm run test:css && npm run test:settings && npm run test:rules",
    "test:css": "node scripts/validate-css.js",
    "test:settings": "node scripts/validate-settings.js",
    "test:rules": "node scripts/test-css-rules.js",
    "test:verify-build": "node scripts/verify-build.js",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
